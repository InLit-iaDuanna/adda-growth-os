+import fs from 'node:fs';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+import { spawnSync } from 'node:child_process';
+
+const directory = 'artifacts/audit-n01-n08';
+fs.mkdirSync(directory, { recursive: true });
+const sourceFiles = [];
+function collect(directory) {
+  for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
+    const file = path.join(directory, entry.name);
+    if (entry.isDirectory() && entry.name !== 'node_modules') collect(file);
+    else if (entry.isFile()) sourceFiles.push(file);
+  }
+}
+for (const directory of ['apps', 'packages', 'tests', 'scripts', 'fixtures']) collect(directory);
+sourceFiles.push('package.json', 'package-lock.json', 'tsconfig.json', 'docs/capabilities.json');
+const checks = [];
+for (const script of ['typecheck', 'build', 'test', 'security:scan', 'test:ai', 'fixtures:verify']) {
+  const args = ['run', script];
+  const started = new Date().toISOString();
+  const result = spawnSync('npm', args, { encoding: 'utf8', maxBuffer: 16 * 1024 * 1024 });
+  const output = (result.stdout || '') + (result.stderr || '') + (result.error ? String(result.error) : '');
+  const log = `${directory}/${script.replaceAll(':', '-')}.log`;
+  fs.writeFileSync(log, output);
+  const check = { command: `npm ${args.join(' ')}`, started_at: started, finished_at: new Date().toISOString(), exit_code: result.status ?? 1, log };
+  if (script === 'test') {
+    const count = name => [...output.matchAll(new RegExp(`(?:ℹ|#) ${name} (\\d+)`, 'g'))].reduce((sum, match) => sum + Number(match[1]), 0);
+    check.tests = { total: count('tests'), passed: count('pass'), failed: count('fail'), skipped: count('skipped'), cancelled: count('cancelled') };
+    if (!check.tests.total || check.tests.failed || check.tests.skipped || check.tests.cancelled || check.tests.passed !== check.tests.total) check.exit_code = check.exit_code || 1;
+  }
+  checks.push(check);
+  console.log(`${check.command}: exit ${check.exit_code}`);
