# Production must provide a secret; no default password or demo seed is used.
APP_MODE=production
SESSION_SECRET=replace-with-at-least-32-random-characters
ADDA_DATA_DIR=./data
HOST=127.0.0.1
PORT=3000
# Set DATABASE_URL only when the PostgreSQL/Prisma adapter is installed.
# DATABASE_URL=postgresql://user:password@localhost:5432/adda
